<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_gradient"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- Animated logo icon -->
        <TextView
            android:id="@+id/logo_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_card"
            android:text="\uD83E\uDDE0"
            android:textSize="48sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- App name -->
        <TextView
            android:id="@+id/logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StressWatch AI"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="8dp" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hybrid Real-Time Stress Detection"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="48dp" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/loading_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="200dp"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:progressTint="@color/brand_purple"
            android:indeterminateTint="@color/brand_purple" />

    </LinearLayout>

    <!-- Version -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="v1.0.0 \u00b7 All processing on-device"
        android:textSize="11sp"
        android:textColor="@color/text_tertiary" />

</FrameLayout>
